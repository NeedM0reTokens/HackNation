{
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true,
      },
    },
  },
  "lsp": {
    "ruff": {
      "binary": {
        "path_lookup": true,
      },
    },
    "basedpyright": {
      "binary": {
        "path_lookup": true,
      },
    },
  },
}
