{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdminConfigSchema",
  "description": "JSON Schema for ZUS Allowance Guide Legal & Calculation Parameters (BE-03 / SETUP-06)",
  "type": "object",
  "required": ["benefit_rates", "leave_durations", "periods_and_limits"],
  "properties": {
    "benefit_rates": {
      "type": "object",
      "properties": {
        "pregnancy_sick_leave_rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "standard_sick_leave_rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "unified_benefit_rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "full_maternity_rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "standard_parental_rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "paternity_benefit_rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "rehabilitation_benefit_rate_first_3_months": { "type": "number", "minimum": 0, "maximum": 100 },
        "rehabilitation_benefit_rate_remaining": { "type": "number", "minimum": 0, "maximum": 100 },
        "rehabilitation_benefit_rate_pregnancy": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "leave_durations": {
      "type": "object",
      "properties": {
        "maternity_weeks_single_child": { "type": "integer", "minimum": 1 },
        "maternity_weeks_twins": { "type": "integer", "minimum": 1 },
        "maternity_weeks_triplets": { "type": "integer", "minimum": 1 },
        "maternity_weeks_quadruplets": { "type": "integer", "minimum": 1 },
        "maternity_weeks_quintuplets_plus": { "type": "integer", "minimum": 1 },
        "mandatory_mother_maternity_weeks": { "type": "integer", "minimum": 1 },
        "parental_weeks_standard": { "type": "integer", "minimum": 1 },
        "parental_weeks_multiple_birth": { "type": "integer", "minimum": 1 },
        "non_transferable_parental_weeks": { "type": "integer", "minimum": 0 },
        "paternity_leave_days": { "type": "integer", "minimum": 1 },
        "max_parental_leave_parts": { "type": "integer", "minimum": 1 }
      }
    },
    "periods_and_limits": {
      "type": "object",
      "properties": {
        "mandatory_waiting_period_days": { "type": "integer", "minimum": 0 },
        "voluntary_waiting_period_days": { "type": "integer", "minimum": 0 },
        "employer_sick_days_standard": { "type": "integer", "minimum": 0 },
        "employer_sick_days_senior": { "type": "integer", "minimum": 0 },
        "senior_age_threshold": { "type": "integer", "minimum": 0 },
        "max_pregnancy_sick_leave_days": { "type": "integer", "minimum": 1 },
        "max_standard_sick_leave_days": { "type": "integer", "minimum": 1 },
        "max_child_age_paternity_months": { "type": "integer", "minimum": 1 },
        "max_child_age_paternity_adoption_years": { "type": "integer", "minimum": 1 },
        "long_application_deadline_days": { "type": "integer", "minimum": 1 },
        "min_wage_2026": { "type": "number", "minimum": 0 },
        "social_contributions_rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "zus_debt_limit_percentage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
